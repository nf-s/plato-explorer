{
  "name": "plato-explorer",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "web",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "vars": {
    "PUBLIC_URL": "https://plato-explorer.<YOUR_SUBDOMAIN>.workers.dev",
    "ADMIN_EMAIL": "admin@example.com",
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "plato-explorer-access",
      "database_id": "<YOUR_D1_DATABASE_ID>",
      "migrations_dir": "worker/auth/migrations",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
    },
  },
}
